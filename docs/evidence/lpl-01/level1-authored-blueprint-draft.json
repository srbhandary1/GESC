  "talk": {
    "scenario": "You are at a community centre. Ask a partner for permission to use an item and answer one permission question.",
    "elicitation_goals": ["Ask one Can I...? question.", "Answer with Yes, you can or No, you cannot.", "State one ability with I can + base verb."],
    "fallback_turns": ["Can I use your pen?", "Yes, you can.", "I can help you."]
  },
  "check": {
    "pass_threshold": 80,
    "items": [
      {"id": "can-01", "weight": 35, "prompt": "Choose the correct sentence.", "options": ["I can speak English.", "I can speaking English.", "I can to speak English."], "correct_option": 0, "rationale": "Can is followed by the base verb speak."},
      {"id": "can-02", "weight": 30, "prompt": "Choose the polite permission question.", "options": ["Can I use your pen?", "I can use your pen?", "Can I using your pen?"], "correct_option": 0, "rationale": "Permission questions use Can I + base verb."},
      {"id": "can-03", "weight": 35, "prompt": "Choose the suitable answer to Can I sit here?", "options": ["Yes, you can.", "Yes, you can to.", "Yes, you can sitting."], "correct_option": 0, "rationale": "A short permission answer uses can without to or an -ing form."}
    ]
  },
  "apply": {
    "task": "Record a 20–30 second exchange: state one ability, ask permission to do one everyday action, and answer one permission question.",
    "rubric": ["Uses one accurate I can statement", "Forms one Can I...? question", "Gives a relevant yes/no permission answer", "Speech is understandable"],
