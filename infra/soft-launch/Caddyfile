# Soft-launch reverse proxy (loopback only).
# Public HTTPS entry is via Cloudflare tunnel to :9080.

{
	auto_https off
}

(laravel_backend) {
	reverse_proxy 127.0.0.1:8000 {
		# This loopback listener is exclusively the HTTPS tunnel origin. The
		# static HTTP listener is a separate Caddy process on port 8080.
		header_up X-Forwarded-Proto https
	}
}

http://:9080 {
	bind 127.0.0.1
	encode gzip

	handle /api/* {
		import laravel_backend
	}

	handle /sanctum/* {
		import laravel_backend
	}

	# Android Passport PKCE uses browser authorization and a stateless token
	# exchange outside /api. These must reach Laravel rather than the SPA
	# fallback or the browser signs into Web without authenticating the app.
	handle /oauth/* {
		import laravel_backend
	}

	handle /auth/mobile/* {
		import laravel_backend
	}

	handle /health/live {
		rewrite * /api/v1/health/live
		import laravel_backend
	}

	handle /health/ready {
		rewrite * /api/v1/health/ready
		import laravel_backend
	}

	@credentialPages path /password-establishment.html /password-recovery.html
	handle @credentialPages {
		header Cache-Control "no-store, max-age=0"
		header Referrer-Policy "no-referrer"
		header X-Robots-Tag "noindex, nofollow"
		root * {$GE_SOFT_LAUNCH_WEB_ROOT}
		file_server
	}

	handle {
		root * {$GE_SOFT_LAUNCH_WEB_ROOT}
		try_files {path} /index.html
		file_server
	}
}
