[Unit]
Description=Global English invite-only soft launch
Documentation=file://@PROJECT_ROOT@/docs/SOFT_LAUNCH_UBUNTU_RUNBOOK.md
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@PROJECT_ROOT@/scripts/run-soft-launch.sh supervise
ExecStop=-/usr/bin/make -C @PROJECT_ROOT@ soft-launch-stop
Restart=on-failure
RestartSec=5
TimeoutStartSec=240
TimeoutStopSec=90

[Install]
WantedBy=default.target
