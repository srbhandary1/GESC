{
  "name": "@global-english/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "e2e": "playwright test",
    "e2e:demo": "playwright test --config=playwright.demo.config.ts",
    "lint": "pnpm --dir ../.. exec eslint apps/web --max-warnings=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@global-english/contracts": "workspace:*",
    "@global-english/design-system": "workspace:*",
    "@global-english/localization": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.1",
    "typescript": "6.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
