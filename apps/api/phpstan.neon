includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8
    paths:
        - app
        - bootstrap
        - database
        - routes
        - tests
    # Keep analyzer cache outside container-mounted application storage so
    # host and container users cannot strand one another with unwritable files.
    tmpDir: /tmp/global-english-api-phpstan
