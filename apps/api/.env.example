APP_NAME="Global English API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=global_english
DB_USERNAME=global_english
DB_PASSWORD=local-development-only-change-me
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_COOKIE=global_english_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000

AUTH_WEB_IDLE_MINUTES=120
AUTH_WEB_ABSOLUTE_MINUTES=10080
# Local-only stable HMAC key. Production requires an independently generated,
# access-controlled and backed-up key that is not rotated with APP_KEY.
AUTH_IDENTITY_DIGEST_KEY=base64:Z2xvYmFsLWVuZ2xpc2gtaWRlbnRpdHktbG9jYWwta2V5
AUTH_PRIVILEGED_IDLE_MINUTES=30
AUTH_PRIVILEGED_ABSOLUTE_MINUTES=720
AUTH_PRIVILEGED_MFA_FRESH_MINUTES=15
# Comma-separated stable user ULIDs. Empty denies every platform content
# emergency operation; organization membership never populates this list.
PLATFORM_CONTENT_EMERGENCY_ACTOR_USER_IDS=
# Stable user ULID for the exact APP-0004 consolidated-role evidence. Empty
# denies self-appointment; this setting grants no permission by itself.
CONTENT_GOVERNANCE_APP_0004_ACTOR_USER_ID=
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_DRIVER=local
# Local-only fake code; ignored outside APP_ENV=local.
AUTH_OTP_LOCAL_FIXED_CODE=000000
AUTH_MOBILE_ACCESS_TOKEN_MINUTES=15
AUTH_MOBILE_FAMILY_INACTIVITY_DAYS=30
AUTH_MOBILE_FAMILY_ABSOLUTE_DAYS=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_HEALTH_CONNECT_TIMEOUT=0.5
REDIS_HEALTH_READ_TIMEOUT=0.5

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="local@global-english.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=global-english-local
AWS_SECRET_ACCESS_KEY=local-development-only-change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=global-english-local
AWS_ENDPOINT=http://127.0.0.1:8333
AWS_USE_PATH_STYLE_ENDPOINT=true

OTP_PROVIDER_BASE_URL=http://127.0.0.1:8089
