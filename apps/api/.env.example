APP_NAME="Global English API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
TRUSTED_PROXIES=127.0.0.1,::1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=json
LOG_STACK=json
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=global_english
DB_USERNAME=global_english
DB_PASSWORD=local-development-only-change-me
DB_TIMEZONE=UTC

SESSION_DRIVER=database
SESSION_COOKIE=global_english_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5174,127.0.0.1,127.0.0.1:5174,127.0.0.1:8000

AUTH_WEB_IDLE_MINUTES=120
AUTH_WEB_ABSOLUTE_MINUTES=10080
AUTHENTICATION_MODE=credential_migration
AUTH_PASSWORD_POLICY_VERSION=1
AUTH_PASSWORD_CONFIRMATION_MINUTES=5
AUTH_PASSWORD_ARGON_MEMORY=65536
AUTH_PASSWORD_ARGON_TIME=3
AUTH_PASSWORD_ARGON_THREADS=1
AUTH_PASSWORD_BLOCKLIST_PATH=
AUTH_PASSWORD_BLOCKLIST_SHA256=
AUTH_PASSWORD_CUTOVER_EXCLUSION_RECONCILIATION_ENABLED=false
AUTH_PASSWORD_CUTOVER_MANIFEST_SHA256=
AUTH_PASSWORD_RECOVERY_DELIVERY_DRIVER=unavailable
AUTH_PASSWORD_PROTECTED_DELIVERY_PATH=/tmp/global-english-password-recovery-deliveries
# Local-only recovery digest key. Production requires an independently
# generated mode-0600 secret supplied outside Git.
AUTH_RECOVERY_DIGEST_KEY=base64:Z2xvYmFsLWVuZ2xpc2gtcmVjb3ZlcnktbG9jYWwta2V5
# Local-only stable HMAC key. Production requires an independently generated,
# access-controlled and backed-up key that is not rotated with APP_KEY.
AUTH_IDENTITY_DIGEST_KEY=base64:Z2xvYmFsLWVuZ2xpc2gtaWRlbnRpdHktbG9jYWwta2V5
AUTH_PRIVILEGED_IDLE_MINUTES=30
AUTH_PRIVILEGED_ABSOLUTE_MINUTES=720
AUTH_PRIVILEGED_MFA_FRESH_MINUTES=15
# Comma-separated stable user ULIDs. Empty denies every platform content
# emergency operation; organization membership never populates this list.
PLATFORM_CONTENT_EMERGENCY_ACTOR_USER_IDS=
# Comma-separated stable, active platform user ULIDs. Empty denies account
# setup/contact replacement; organization membership never grants this power.
PLATFORM_ACCOUNT_RECOVERY_MANAGER_USER_IDS=
# Stable user ULID for the exact APP-0004 consolidated-role evidence. Empty
# denies self-appointment; this setting grants no permission by itself.
CONTENT_GOVERNANCE_APP_0004_ACTOR_USER_ID=
AUTH_OTP_TTL_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_DRIVER=local
# Local-only fake code; ignored outside APP_ENV=local.
AUTH_OTP_LOCAL_FIXED_CODE=000000
# One-shot APP-0049 exception. Enable only for the reviewed local command and
# remove it from the invoking process immediately afterward.
LOCAL_OPERATOR_IDENTITY_BOOTSTRAP_ENABLED=false
# One-shot APP-0051 exception. Enable only for the exact local LPL-01 command
# and remove it from the invoking process immediately afterward.
LPL01_PILOT_AUTHORITY_BOOTSTRAP_ENABLED=false
# DR-0025 curriculum-media transcription remains disabled by default. These
# values must be supplied only to the dedicated lpl-media-transcription
# process. Credentials, permits and evidence files must stay outside Git.
LPL_MEDIA_TRANSCRIPTION_ENABLED=false
LPL_MEDIA_TRANSCRIPTION_LIVE_REQUESTS_ENABLED=false
LPL_MEDIA_TRANSCRIPTION_AZURE_ENDPOINT=
LPL_MEDIA_TRANSCRIPTION_AZURE_ALLOWED_HOST=
LPL_MEDIA_TRANSCRIPTION_AZURE_CREDENTIAL_KIND=
LPL_MEDIA_TRANSCRIPTION_AZURE_SECRET_FILE=
LPL_MEDIA_TRANSCRIPTION_VENDOR_EVIDENCE_FILE=
LPL_MEDIA_TRANSCRIPTION_VENDOR_EVIDENCE_SHA256=
LPL_MEDIA_TRANSCRIPTION_PRICE_EVIDENCE_FILE=
LPL_MEDIA_TRANSCRIPTION_PRICE_EVIDENCE_SHA256=
LPL_MEDIA_TRANSCRIPTION_PERMIT_FILE=
LPL_MEDIA_TRANSCRIPTION_SAFE_REPORT_FILE=
LPL_MEDIA_TRANSCRIPTION_CANDIDATE_DRIVER=local
LPL_MEDIA_TRANSCRIPTION_CANDIDATE_DISK=media_transcription_candidates
AUTH_MOBILE_ACCESS_TOKEN_MINUTES=15
AUTH_MOBILE_FAMILY_INACTIVITY_DAYS=30
AUTH_MOBILE_FAMILY_ABSOLUTE_DAYS=90

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
LEARNING_MODEL_AUDIO_DISK=s3
# ADR-0016: long-form teaching audio remains private and distinct from short
# model audio. It may share a private disk while retaining a separate usage key.
LEARNING_LESSON_AUDIO_DISK=s3
MEDIA_QUARANTINE_DISK=media_quarantine
MEDIA_QUARANTINE_DRIVER=local
MEDIA_UPLOAD_PART_SIZE_BYTES=1048576
MEDIA_INSPECTOR_DRIVER=unavailable
MEDIA_FFPROBE_BINARY=/usr/bin/ffprobe
MEDIA_SCANNER_DRIVER=unavailable
MEDIA_CLAMAV_HOST=127.0.0.1
MEDIA_CLAMAV_PORT=3310
# ADR-0013: staging/prod-like hosts should use the private lesson_videos disk
# (S3 prefix). Local may keep local/s3; never expose public object URLs to clients.
LEARNING_LESSON_VIDEO_DISK=lesson_videos
AWS_LESSON_VIDEO_PREFIX=lesson-videos
# Local-only signing key for purpose-specific offline authorization leases.
# Production requires an independently generated, access-controlled key.
OFFLINE_BUNDLE_SIGNING_KEY=base64:Z2xvYmFsLWVuZ2xpc2gtb2ZmbGluZS1sb2NhbC1rZXktdjE=
OFFLINE_LEASE_MINUTES=1440
OFFLINE_BUNDLE_RETENTION_DAYS=30
OFFLINE_PENDING_COMMAND_ACTIVE_DAYS=30
# Confidence Conversation model DI. Production must remain disabled.
# Non-production allowlist: local | testing | conversation-model-dev | staging
# with driver fake | azure-openai-dev. See docs/STAGING_CONFIDENCE_CONVERSATION.md
# and scripts/setup-conversation-model-workspace.sh (APP-0022 / ADR-0010).
CONVERSATION_PROVIDER_DRIVER=disabled
CONVERSATION_AZURE_OPENAI_LIVE_REQUESTS_ENABLED=false
CONVERSATION_AZURE_OPENAI_ENDPOINT=
CONVERSATION_AZURE_OPENAI_ALLOWED_HOST=
CONVERSATION_AZURE_OPENAI_DEPLOYMENT=
CONVERSATION_AZURE_OPENAI_API_VERSION=2024-10-21
CONVERSATION_AZURE_OPENAI_CREDENTIAL_KIND=
CONVERSATION_AZURE_OPENAI_SECRET_FILE=
CONVERSATION_AZURE_OPENAI_APPROVED_SPEND_CAP_INR=
CONVERSATION_AZURE_OPENAI_VENDOR_EVIDENCE_PATH=
CONVERSATION_AZURE_OPENAI_SPEND_APPROVAL_PATH=
# Soft-launch GuidanceTtsPolicy Azure Speech TTS (APP-0064). Separate from the
# locked PR-009 speech-benchmark environment. Production must remain false.
CONVERSATION_GUIDANCE_TTS_LIVE_REQUESTS_ENABLED=false
CONVERSATION_GUIDANCE_TTS_ENDPOINT=
CONVERSATION_GUIDANCE_TTS_ALLOWED_HOST=
CONVERSATION_GUIDANCE_TTS_CREDENTIAL_KIND=
CONVERSATION_GUIDANCE_TTS_SECRET_FILE=
CONVERSATION_GUIDANCE_TTS_APPROVED_SPEND_CAP_INR=
CONVERSATION_GUIDANCE_TTS_VENDOR_EVIDENCE_PATH=
CONVERSATION_GUIDANCE_TTS_SPEND_APPROVAL_PATH=
CONVERSATION_GUIDANCE_TTS_SUBSCRIPTION_EVIDENCE_ID=
CONVERSATION_GUIDANCE_TTS_CONTRACTING_ENTITY_REVIEW_ID=
CONVERSATION_GUIDANCE_TTS_AGREEMENT_SHA256=
CONVERSATION_GUIDANCE_TTS_DPA_SHA256=
CONVERSATION_GUIDANCE_TTS_SUBPROCESSOR_SHA256=
CONVERSATION_GUIDANCE_TTS_PRIVACY_LEGAL_REVIEW_ID=
CONVERSATION_GUIDANCE_TTS_LOGGING_DISABLED_EVIDENCE_ID=
CONVERSATION_GUIDANCE_TTS_CREDENTIAL_VERSION_ID=
CONVERSATION_GUIDANCE_TTS_SPEND_APPROVAL_ID=
CONVERSATION_GUIDANCE_TTS_INR_PER_CHARACTER=0.0003814041
# PR-009 remains off by default. Local development additionally requires an
# explicit comma-separated organization ULID allowlist. Tests use synthetic
# organizations from their isolated database.
# Invite-only soft-launch may enable learner STT (APP-0068) with an organization
# allowlist. Production and Play stay disabled.
VOICE_UPLOAD_ENABLED=false
VOICE_PROVIDER_DRIVER=disabled
VOICE_DELETION_LEASE_SECONDS=300
VOICE_DELETION_RETRY_BASE_SECONDS=60
VOICE_DELETION_RETRY_MAX_SECONDS=3600
VOICE_DELETION_MAX_ATTEMPTS=5
VOICE_DELETION_OUTBOX_STALE_SECONDS=3600
VOICE_ALLOWED_ORGANIZATION_IDS=
VOICE_STORAGE_DISK=local
# Optional Indic HTTP STT (translate-to-English). Soft-launch stays Azure
# until VOICE_PROVIDER_DRIVER=indic with a mode-0600 secret file outside git.
VOICE_INDIC_TRANSCRIBE_URL=
VOICE_INDIC_ALLOWED_HOST=
VOICE_INDIC_SECRET_FILE=
VOICE_INDIC_AUTH_HEADER=api-subscription-key
VOICE_INDIC_MODEL=
VOICE_INDIC_MODE=translate
VOICE_INDIC_LANGUAGE_CODE=unknown
VOICE_INDIC_OUTPUT_LANGUAGE=en-IN
# 1:1 destination contact links. Empty values hide the link. E.164 phone;
# WhatsApp digits or +number; email. Do not invent a live number in git.
TUITION_CONTACT_PHONE=
TUITION_CONTACT_WHATSAPP=
TUITION_CONTACT_EMAIL=
# PR-009 Azure Speech remains fail-closed. These fields are documentation-only;
# do not put credentials in this file or either real .env file. A separately
# approved benchmark uses a mode-0600 secret file outside this repository.
AZURE_SPEECH_LIVE_REQUESTS_ENABLED=false
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_ALLOWED_HOST=
AZURE_SPEECH_CREDENTIAL_KIND=
AZURE_SPEECH_SECRET_FILE=
SPEECH_BENCHMARK_ENABLED=false
SPEECH_BENCHMARK_RUNNER_COMMIT=
SPEECH_BENCHMARK_APPROVED_SPEND_CAP_INR=
AZURE_SPEECH_VENDOR_EVIDENCE_PATH=
SPEECH_BENCHMARK_SPEND_APPROVAL_PATH=
SPEECH_BENCHMARK_SAFE_REPORT_PATH=
SPEECH_BENCHMARK_LISTENER_EVIDENCE_PATH=
SPEECH_BENCHMARK_EPHEMERAL_ROOT=
SPEECH_BENCHMARK_EPHEMERAL_STORAGE_ACKNOWLEDGED=false
AZURE_SPEECH_SUBSCRIPTION_EVIDENCE_ID=
AZURE_SPEECH_CONTRACTING_ENTITY_REVIEW_ID=
AZURE_SPEECH_AGREEMENT_SHA256=
AZURE_SPEECH_DPA_SHA256=
AZURE_SPEECH_SUBPROCESSOR_SHA256=
AZURE_SPEECH_PRIVACY_LEGAL_REVIEW_ID=
AZURE_SPEECH_LOGGING_DISABLED_EVIDENCE_ID=
AZURE_SPEECH_CREDENTIAL_VERSION_ID=
SPEECH_BENCHMARK_SPEND_APPROVAL_ID=
AZURE_SPEECH_PRICE_SNAPSHOT_ID=
SPEECH_BENCHMARK_CONTENT_SCAN_EVIDENCE_ID=
AZURE_SPEECH_INR_PER_STT_SECOND=
AZURE_SPEECH_INR_PER_TTS_CHARACTER=
AZURE_SPEECH_INR_CONVERSION_SOURCE=
AZURE_SPEECH_INR_CONVERSION_INSTANT=
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_HEALTH_CONNECT_TIMEOUT=0.5
REDIS_HEALTH_READ_TIMEOUT=0.5

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="local@global-english.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=global-english-local
AWS_SECRET_ACCESS_KEY=local-development-only-change-me
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=global-english-local
AWS_ENDPOINT=http://127.0.0.1:8333
AWS_USE_PATH_STYLE_ENDPOINT=true

OTP_PROVIDER_BASE_URL=http://127.0.0.1:8089
